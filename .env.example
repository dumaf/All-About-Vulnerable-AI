# ── LLM Configuration ────────────────────────────────────────────────────────
LLM_MODEL_PATH=Llama-3.2-3B-Instruct/
LLM_ADAPTER_1=llm/lora-grounding-output/final_adapter
LLM_ADAPTER_2=llm/lora-aavai-output/final_adapter
LLM_WEIGHT_1=0.2
LLM_WEIGHT_2=0.4
LLM_WEIGHT_BASE=0.4

# ── File Upload Configuration ────────────────────────────────────────────────
UPLOAD_DIR=backend/modules/rag_poisoning/document_store
ALLOWED_EXTENSIONS=.pdf,.txt
MAX_UPLOAD_SIZE_BYTES=52428800

# ── FAISS / Embeddings Configuration (Recommended for RAG poisoning)──────────
FAISS_INDEX_PATH=backend/modules/rag_poisoning/faiss_index
FAISS_METADATA_PATH=backend/modules/rag_poisoning/faiss_metadata.json
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── RAG Parameters ───────────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=3

# ── Server Configuration ─────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
# Model DoS backend (optional — defaults to HOST above and port 5001)
# DOS_HOST=127.0.0.1
DOS_PORT=5001

# ── Challenge Flags ──────────────────────────────────────────────────────────
FLAG_PROMPT_INJECTION=PR0MPT_1NJ3CT10N_SUCC3SS
FLAG_PROMPT_INJECTION_SECRET=y1p33
FLAG_RAG_POISONING=1_am_th3_AI
FLAG_CONTEXT_POISONING=C0NT3XT_P01S0N1NG_SUCC3SS
FLAG_SENSITIVE_INFO=llm_agent_db_l3ak_pwnd
FLAG_OUTPUT_HANDLING=OUTPUT_HANDLING_SUCCESS
